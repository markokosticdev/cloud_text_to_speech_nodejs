# ====================================================================
# Cloud Text-to-Speech v3 - Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your actual API credentials
# 
# Security Note: Never commit your actual .env file to version control!
# Add .env to your .gitignore file.
# ====================================================================

# --------------------------------------------------------------------
# Google Cloud Text-to-Speech Configuration
# --------------------------------------------------------------------
# Required: Google Cloud API Key with Text-to-Speech API enabled
# How to get: https://cloud.google.com/text-to-speech/docs/before-you-begin
GOOGLE_API_KEY=your-google-cloud-api-key-here

# Optional: Google Cloud Project ID (if using service account)
# GOOGLE_PROJECT_ID=your-project-id

# Optional: Google Cloud Service Account Key File Path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --------------------------------------------------------------------
# Microsoft Azure Cognitive Services Configuration  
# --------------------------------------------------------------------
# Required: Azure Cognitive Services Subscription Key
# How to get: https://docs.microsoft.com/en-us/azure/cognitive-services/speech-service/
MICROSOFT_TTS_SUBSCRIPTION_KEY=your-azure-subscription-key-here

# Required: Azure Service Region
# Common values: eastus, westus2, centralus, northeurope, southeastasia
MICROSOFT_TTS_REGION=eastus

# Optional: Azure Service Endpoint (if using custom endpoint)
# MICROSOFT_TTS_ENDPOINT=https://your-custom-endpoint.cognitiveservices.azure.com/

# --------------------------------------------------------------------
# Amazon Polly Configuration
# --------------------------------------------------------------------
# Required: AWS Access Key ID with Polly permissions
# How to get: https://docs.aws.amazon.com/polly/latest/dg/setting-up.html
AMAZON_TTS_KEY_ID=your-aws-access-key-id-here

# Required: AWS Secret Access Key
AMAZON_TTS_ACCESS_KEY=your-aws-secret-access-key-here

# Required: AWS Region where Polly service is available
# Common values: us-east-1, us-west-2, eu-west-1, ap-southeast-1
AMAZON_TTS_REGION=us-east-1

# Optional: AWS Session Token (if using temporary credentials)
# AMAZON_TTS_SESSION_TOKEN=your-session-token-here

# --------------------------------------------------------------------
# Example Configuration (Development/Testing)
# --------------------------------------------------------------------
# Uncomment and modify these for testing with placeholder values

# Development mode settings
# NODE_ENV=development
# TTS_DEBUG=true
# TTS_TIMEOUT=30000

# Example rate limiting
# TTS_RATE_LIMIT_REQUESTS=10
# TTS_RATE_LIMIT_WINDOW=60000

# Example output settings
# TTS_OUTPUT_DIR=./output
# TTS_DEFAULT_FORMAT=mp3
# TTS_DEFAULT_QUALITY=128k

# --------------------------------------------------------------------
# Provider-Specific Advanced Settings
# --------------------------------------------------------------------

# Google Advanced Settings
# GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com
# GOOGLE_TTS_TIMEOUT=30000

# Microsoft Advanced Settings  
# MICROSOFT_TTS_TIMEOUT=30000
# MICROSOFT_TTS_RETRY_ATTEMPTS=3

# Amazon Advanced Settings
# AMAZON_TTS_TIMEOUT=30000
# AMAZON_TTS_RETRY_ATTEMPTS=3

# --------------------------------------------------------------------
# Security and Network Configuration
# --------------------------------------------------------------------

# HTTP Proxy Settings (if required by your network)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=https://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.local

# SSL/TLS Settings
# TLS_REJECT_UNAUTHORIZED=true

# --------------------------------------------------------------------
# Logging and Monitoring
# --------------------------------------------------------------------

# Log level: error, warn, info, debug, trace
# LOG_LEVEL=info

# Enable request/response logging
# LOG_REQUESTS=false
# LOG_RESPONSES=false

# Performance monitoring
# ENABLE_METRICS=false
# METRICS_PORT=9090

# ====================================================================
# Quick Setup Instructions:
# ====================================================================
# 1. Copy this file: cp .env-example .env
# 2. Edit .env with your actual API credentials
# 3. Run: npm run validate-env (to verify configuration)
# 4. Run: npm run demo (to test basic functionality)
# ==================================================================== 